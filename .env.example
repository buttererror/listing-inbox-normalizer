PORT=3000
DATABASE_URL=file:./dev.db
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=your_provider_api_key_here
LLM_TIMEOUT_MS=45000
# API providers (require LLM_API_KEY and explicit LLM_MODEL):
#   Anthropic API: LLM_PROVIDER=anthropic
#   OpenAI API:    LLM_PROVIDER=openai
# Local CLI providers (LLM_API_KEY is ignored; uses local CLI auth):
#   Claude CLI:    LLM_PROVIDER=claude-cli  (alias: claude; optional LLM_MODEL, CLAUDE_EXECUTABLE)
#   Antigravity:   LLM_PROVIDER=agy         (alias: antigravity; optional LLM_MODEL, AGY_EXECUTABLE)
