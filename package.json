{
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.99",
    "@ai-sdk/google": "4.0.114",
    "@ai-sdk/openai": "4.0.111",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "ai": "7.0.166",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "name": "listing-inbox-normalizer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "pnpm run build && pnpm run db:deploy && node dist/main.js",
    "start:dev": "pnpm run db:deploy && ts-node src/main.ts",
    "cli": "pnpm run build 1>&2 && node dist/cli.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "RUST_LOG=info prisma migrate deploy"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "multer": "2.5.0"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "prisma",
      "@prisma/engines"
    ]
  },
  "type": "commonjs"
}
