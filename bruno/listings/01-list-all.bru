meta {
  name: List All Listings
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/listings
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody();
  const flagged = body?.listings?.filter((item) => item.needs_review === true) ?? [];
  if (flagged.length > 0) {
    bru.setVar("listingId", flagged[0].id);
    bru.setVar("noteListingId", (flagged[1] ?? flagged[0]).id);
  }
  const clean = body?.listings?.find((item) => item.needs_review === false);
  if (clean) {
    bru.setVar("cleanListingId", clean.id);
  }
}
